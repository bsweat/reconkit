# Copy this file to .env and fill in your API keys
# All keys have free tiers — links below

# Shodan — https://account.shodan.io/ (free: 1 query/sec)
SHODAN_API_KEY=your_key_here

# VirusTotal — https://www.virustotal.com/gui/join-us (free: 4 req/min)
VIRUSTOTAL_API_KEY=your_key_here

# ipinfo.io — https://ipinfo.io/signup (free: 50k req/month)
IPINFO_TOKEN=your_key_here

# HaveIBeenPwned — https://haveibeenpwned.com/API/Key (free for personal)
HIBP_API_KEY=your_key_here
